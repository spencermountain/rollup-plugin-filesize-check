{
  "name": "rollup-plugin-filesize-check",
  "version": "1.2.0",
  "description": "ensure rollup builds are the expected size",
  "license": "MIT",
  "repository": "github:spencermountain/rollup-plugin-filesize-check",
  "homepage": "https://github.com/spencermountain/rollup-plugin-filesize-check#readme",
  "bugs": "https://github.com/spencermountain/rollup-plugin-filesize-check/issues",
  "author": "spencermountain",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "test": "tape \"./tests/**/*.test.js\"",
    "lint": "eslint .",
    "test:types": "tsc -p tests/tsconfig.json",
    "check": "npm test && npm run test:types && npm run lint"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "keywords": [
    "rollup",
    "filesize"
  ],
  "dependencies": {
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "rollup": "^4.63.4",
    "tape": "5.10.2",
    "tape-async": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "rollup": "^4.63.4"
  }
}
