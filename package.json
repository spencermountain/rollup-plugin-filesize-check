{
  "name": "rollup-plugin-filesize-check",
  "version": "2.0.0",
  "description": "ensure rollup builds are the expected size",
  "license": "MIT",
  "repository": "github:spencermountain/rollup-plugin-filesize-check",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "test": "tape ./tests/reporter.js \"./tests/**/*.test.js\"",
    "lint": "eslint .",
    "test:types": "tsc -p tests/tsconfig.json",
    "check": "npm test && npm run test:types && npm run lint"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "keywords": [
    "rollup",
    "filesize"
  ],
  "dependencies": {
    "picomatch": "4.0.3"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "rollup": "4.63.4",
    "tap-dancer": "0.4.1",
    "tape": "5.10.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "rollup": ">=2.78.0"
  }
}
