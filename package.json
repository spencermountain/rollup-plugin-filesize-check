{
  "name": "rollup-plugin-filesize-check",
  "version": "2.0.1",
  "description": "ensure rollup builds are the expected size",
  "license": "MIT",
  "repository": "github:spencermountain/rollup-plugin-filesize-check",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "test": "tape \"./tests/**/*.test.js\" | tap-dancer",
    "lint": "eslint .",
    "test:types": "tsc -p tests/tsconfig.json",
    "check": "npm test && npm run lint"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "keywords": [
    "rollup",
    "filesize"
  ],
  "devDependencies": {
    "eslint": "10.12.0",
    "rollup": "4.64.3",
    "tap-dancer": "0.4.4",
    "tape": "5.10.2"
  },
  "peerDependencies": {
    "rollup": ">=2.78.0"
  }
}
